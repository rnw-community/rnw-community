{
  "name": "rnw-community",
  "version": "0.59.4",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rnw-community/rnw-community.git"
  },
  "workspaces": [
    "packages/*",
    "packages/react-native-collapsible-header-example/apps/*",
    "packages/react-native-payments-example/apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:force": "turbo run build --force",
    "clear": "turbo run clear",
    "cpd": "jscpd packages",
    "deadcode": "yarn knip",
    "deps:check": "yarn dlx check-dependency-version-consistency .",
    "deps:clear": "turbo run clear:deps && yarn deps:clear:root",
    "deps:clear:root": "rm -rf ./node_modules",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:force": "turbo run lint --force",
    "publint": "bash scripts/publint.sh",
    "release": "lerna publish --yes --conventional-commits --create-release=github -m \"chore: release %s [skip ci]\"",
    "smoke:esm": "node scripts/smoke-esm.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "ts": "turbo run ts",
    "ts:force": "turbo run ts --force",
    "ts:nodenext": "turbo run ts:nodenext",
    "ts:nodenext:force": "turbo run ts:nodenext --force"
  },
  "resolutions": {
    "@expo/cli": "57.0.6",
    "@expo/metro-runtime": "57.0.3",
    "@types/react": "19.2.18",
    "axios": "^1.19.0",
    "babel-jest": "^29.7.0",
    "expo": "57.0.4",
    "expo-asset": "57.0.3",
    "expo-constants": "57.0.3",
    "expo-file-system": "57.0.0",
    "expo-font": "57.0.0",
    "expo-keep-awake": "57.0.0",
    "expo-modules-autolinking": "57.0.5",
    "expo-modules-core": "57.0.3",
    "expo-modules-jsi": "57.0.1",
    "ip-address": "^10.3.1",
    "js-yaml@4.1.1": "^4.3.1",
    "nanoid@^3.3.16": "^3.3.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "tar@7.5.11": "^7.5.21",
    "tar@^7.4.3": "^7.5.21",
    "tar@^7.5.4": "^7.5.21"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/config-lerna-scopes": "^20.4.3",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jscpd": "^4.2.5",
    "knip": "^5.88.1",
    "lerna": "^9.0.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "sort-package-json": "^3.7.1",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
