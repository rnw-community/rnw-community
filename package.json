{
  "name": "rnw-community",
  "version": "0.59.4",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/react-native-payments-example/apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:force": "turbo run build --force",
    "clear": "turbo run clear",
    "cpd": "jscpd packages",
    "deadcode": "yarn knip",
    "deps:check": "yarn dlx check-dependency-version-consistency .",
    "deps:clear": "turbo run clear:deps && yarn deps:clear:root",
    "deps:clear:root": "rm -rf ./node_modules",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:force": "turbo run lint --force",
    "release": "lerna publish --yes --conventional-commits --create-release=github -m \"chore: release %s [skip ci]\"",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "ts": "turbo run ts",
    "ts:force": "turbo run ts --force"
  },
  "resolutions": {
    "axios": "^1.19.0",
    "babel-jest": "^29.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/config-lerna-scopes": "^20.4.3",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jscpd": "^4.2.5",
    "knip": "^6.30.0",
    "lerna": "^9.0.7",
    "lint-staged": "^16.4.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "sort-package-json": "^3.7.1",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
