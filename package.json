{
  "name": "rnw-community",
  "version": "0.59.4",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rnw-community/rnw-community.git"
  },
  "scripts": {
    "build": "turbo run build",
    "build:force": "turbo run build --force",
    "clear": "turbo run clear",
    "cpd": "jscpd packages",
    "deadcode": "pnpm knip",
    "deps:check": "pnpm dlx check-dependency-version-consistency .",
    "deps:clear": "turbo run clear:deps && pnpm deps:clear:root",
    "deps:clear:root": "rm -rf ./node_modules",
    "deps:dedupe": "pnpm dedupe",
    "deps:update": "pnpm dlx npm-check-updates",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:force": "turbo run lint --force",
    "publint": "bash scripts/publint.sh",
    "release": "lerna publish --yes --conventional-commits --create-release=github -m \"chore: release %s [skip ci]\"",
    "smoke:esm": "node scripts/smoke-esm.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "ts": "turbo run ts",
    "ts:force": "turbo run ts --force",
    "ts:nodenext": "turbo run ts:nodenext",
    "ts:nodenext:force": "turbo run ts:nodenext --force"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/config-lerna-scopes": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^29.7.0",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "babel-jest": "^30.4.1",
    "eslint": "^10.9.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jscpd": "^5.0.16",
    "knip": "^5.88.1",
    "lerna": "^10.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "sort-package-json": "^4.0.0",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
