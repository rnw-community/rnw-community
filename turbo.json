{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig*.json",
    "get-jest.config.js"
  ],
  "tasks": {
    "topo": {
      "dependsOn": [
        "^topo"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "ts": {
      "dependsOn": [
        "^topo"
      ],
      "outputs": [
        "node_modules/.cache/tsbuildinfo.json"
      ]
    },
    "ts:nodenext": {
      "dependsOn": [
        "^topo"
      ],
      "outputs": [
        "node_modules/.cache/tsbuildinfo-nodenext.json"
      ]
    },
    "lint": {
      "dependsOn": [
        "^topo",
        "@rnw-community/eslint-plugin#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/.oxlintrc.json"
      ],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": [
        "^topo",
        "@rnw-community/eslint-plugin#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/.oxlintrc.json"
      ],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "clear": {
      "outputs": []
    },
    "clear:deps": {
      "outputs": []
    },
    "test": {},
    "test:coverage": {
      "outputs": [
        "coverage/**"
      ]
    },
    "//#cpd": {
      "outputs": [
        "report/jscpd/**"
      ]
    },
    "//#find-deadcode": {
      "outputs": []
    }
  }
}
