{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo-nodenext.json",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "verbatimModuleSyntax": false
    },
    "include": [
        "./src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
