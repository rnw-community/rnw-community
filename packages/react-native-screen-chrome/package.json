{
    "name": "@rnw-community/react-native-screen-chrome",
    "version": "3.0.0",
    "description": "Composable scroll-driven screen chrome for React Native and React Native Web",
    "keywords": [
        "react",
        "react-native",
        "react-native-web",
        "reanimated",
        "screen chrome",
        "collapsible header"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/rnw-community/rnw-community.git",
        "directory": "packages/react-native-screen-chrome"
    },
    "license": "MIT",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./dist/typescript/module/index.d.ts",
                "default": "./dist/module/index.js"
            },
            "require": {
                "types": "./dist/typescript/commonjs/index.d.ts",
                "default": "./dist/commonjs/index.js"
            }
        }
    },
    "main": "dist/commonjs/index.js",
    "module": "dist/module/index.js",
    "browser": {
        "./dist/commonjs/constant/screen-chrome-default-config.constant.js": "./dist/commonjs/constant/screen-chrome-default-config.constant.web.js",
        "./dist/commonjs/edge-fade/edge-fade.js": "./dist/commonjs/edge-fade/edge-fade.web.js",
        "./dist/module/constant/screen-chrome-default-config.constant.js": "./dist/module/constant/screen-chrome-default-config.constant.web.js",
        "./dist/module/edge-fade/edge-fade.js": "./dist/module/edge-fade/edge-fade.web.js"
    },
    "types": "dist/typescript/module/index.d.ts",
    "files": [
        "dist/**/*",
        "android",
        "ios",
        "expo-module.config.json",
        "THIRD_PARTY_NOTICES.md",
        "llms.txt",
        "!dist/**/*.tsbuildinfo",
        "!android/build",
        "!ios/build"
    ],
    "scripts": {
        "build": "rm -rf ./dist && bob build && pnpm run build:esm-extensions && node ../../scripts/write-browser-field-markers.mjs .",
        "build:esm-extensions": "node ../../scripts/rewrite-esm-extensions.mjs ./dist/module && node ../../scripts/rewrite-esm-extensions.mjs ./dist/typescript/module && node ../../scripts/assert-esm-extensions.mjs ./dist/module && node ../../scripts/assert-esm-extensions.mjs ./dist/typescript/module",
        "clear": "rm -rf coverage && rm -rf dist && rm -f *.tsbuildinfo",
        "clear:deps": "rm -rf ./node_modules && rm -rf ./dist",
        "format": "prettier --write \"./src/**/*.{ts,tsx}\"",
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:web": "node web-e2e/build-harness.mjs && playwright test",
        "ts": "tsc --pretty -p tsconfig.json",
        "ts:nodenext": "tsc --pretty -p tsconfig.nodenext-check.json"
    },
    "dependencies": {
        "@rnw-community/shared": "^3.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@playwright/test": "1.64.1",
        "@react-native/babel-preset": "0.88.0",
        "@react-native/jest-preset": "0.88.0",
        "@react-native/metro-config": "0.88.0",
        "@rnw-community/react-native-collapsible-header": "workspace:^",
        "@testing-library/react-native": "^13.3.3",
        "@types/react": "19.3.0",
        "@types/react-test-renderer": "19.1.0",
        "esbuild": "0.21.5",
        "expo": "~58.0.14",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-freeze": "^1.0.3",
        "react-native": "0.88.0",
        "react-native-builder-bob": "^0.43.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-web": "0.21.4",
        "react-native-worklets": "0.13.0",
        "react-test-renderer": "19.3.0"
    },
    "peerDependencies": {
        "@rnw-community/react-native-collapsible-header": ">=2.18.0 <3",
        "expo": ">=55 <59",
        "react": ">=18",
        "react-native": ">=0.78",
        "react-native-reanimated": ">=4.1.0 <5",
        "react-native-safe-area-context": ">=4 <6"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "dist",
        "exclude": "**/{__tests__/**,__fixtures__/**,__mocks__/**,*.spec.{ts,tsx}}",
        "targets": [
            [
                "module",
                {
                    "esm": true,
                    "configFile": "./babel.config.bob.js"
                }
            ],
            [
                "commonjs",
                {
                    "esm": true,
                    "configFile": "./babel.config.bob.js"
                }
            ],
            [
                "typescript",
                {
                    "project": "tsconfig.build.json",
                    "tsc": "../../node_modules/@typescript/native/bin/tsc"
                }
            ]
        ]
    }
}
