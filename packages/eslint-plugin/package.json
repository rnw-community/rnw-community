{
    "name": "@rnw-community/eslint-plugin",
    "version": "2.19.2",
    "description": "RNW-Community ESLint plugin",
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin",
        "rnw-community eslint plugin",
        "eslint plugin JSX"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/rnw-community/rnw-community.git",
        "directory": "packages/eslint-plugin"
    },
    "license": "MIT",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        }
    },
    "main": "dist/cjs/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "sideEffects": false,
    "type": "commonjs",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "ts": "tsc --pretty -p tsconfig.json",
        "ts:nodenext": "tsc --pretty -p tsconfig.nodenext-check.json",
        "build:esm": "tsc --pretty -p tsconfig.build-esm.json",
        "build:cjs": "tsc --pretty -p tsconfig.build-cjs.json",
        "build": "pnpm run build:esm && pnpm run build:cjs && rm -rf ./dist/*/*.tsbuildinfo",
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "format": "prettier --write \"./src/**/*.{ts,tsx}\"",
        "clear": "rm -rf coverage && rm -rf dist && rm -f *.tsbuildinfo",
        "clear:deps": "rm -rf ./node_modules && rm -rf ./dist"
    },
    "gitHead": "4fd24bd92936d1793f8f7ff08d6420fce4f211d9",
    "dependencies": {
        "@typescript-eslint/rule-tester": "^8.65.0",
        "@typescript-eslint/utils": "^8.65.0"
    },
    "devDependencies": {
        "@types/eslint": "^9.6.1"
    },
    "peerDependencies": {
        "eslint": "^9 || ^10"
    }
}
