{
    "name": "@rnw-community/nestjs-typed-config",
    "version": "3.0.5",
    "description": "NestJS typed config",
    "keywords": [
        "nestjs",
        "nestjs config",
        "nestjs ts config",
        "nestjs typescript config"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/rnw-community/rnw-community.git",
        "directory": "packages/nestjs-typed-config"
    },
    "license": "MIT",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        }
    },
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*",
        "llms.txt",
        "!dist/**/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "pnpm run build:esm && pnpm run build:cjs && node ../../scripts/rewrite-esm-extensions.mjs ./dist/esm && node ../../scripts/assert-esm-extensions.mjs ./dist/esm && rm -rf ./dist/*/*.tsbuildinfo && echo '{\"type\":\"module\"}' > dist/esm/package.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
        "build:cjs": "node ../../scripts/typecheck.mjs --pretty -p tsconfig.build-cjs.json",
        "build:esm": "node ../../scripts/typecheck.mjs --pretty -p tsconfig.build-esm.json",
        "clear": "rm -rf coverage && rm -rf dist && rm -f *.tsbuildinfo",
        "clear:deps": "rm -rf ./node_modules && rm -rf ./dist",
        "format": "prettier --write \"./src/**/*.{ts,tsx}\"",
        "lint": "oxlint src && eslint src",
        "lint:fix": "oxlint --fix src && eslint --fix src",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "ts": "node ../../scripts/typecheck.mjs --pretty -p tsconfig.json",
        "ts:nodenext": "node ../../scripts/typecheck.mjs --pretty -p tsconfig.nodenext-check.json"
    },
    "dependencies": {
        "@rnw-community/shared": "^3.0.5"
    },
    "devDependencies": {
        "@nestjs/common": "^12.1.3",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.1.3",
        "@types/hapi__joi": "^17.1.15",
        "joi": "^18.2.6"
    },
    "peerDependencies": {
        "@nestjs/common": "^11.1.28 || ^12.0.0",
        "@nestjs/config": "^4.0.4 || ^12.0.1",
        "joi": "^17.1.1 || ^18.2.5"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "gitHead": "4fd24bd92936d1793f8f7ff08d6420fce4f211d9"
}
