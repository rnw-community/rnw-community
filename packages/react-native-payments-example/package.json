{
    "name": "@rnw-community/react-native-payments-example",
    "version": "3.0.9",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/rnw-community/rnw-community.git",
        "directory": "packages/react-native-payments-example"
    },
    "license": "MIT",
    "sideEffects": false,
    "main": "src/index.ts",
    "module": "src/index.ts",
    "react-native": "src/index.ts",
    "types": "src/index.ts",
    "files": [
        "src/**/*"
    ],
    "scripts": {
        "android:bare": "pnpm --filter @rnw-community/react-native-payments-example-bare android",
        "android:expo": "pnpm --filter @rnw-community/react-native-payments-example-expo android",
        "clear": "rm -rf coverage && rm -rf dist && rm -f *.tsbuildinfo",
        "clear:deps": "rm -rf ./node_modules && rm -rf ./dist",
        "format": "prettier --write \"./src/**/*.{ts,tsx}\"",
        "ios:bare": "pnpm --filter @rnw-community/react-native-payments-example-bare ios",
        "ios:expo": "pnpm --filter @rnw-community/react-native-payments-example-expo ios",
        "lint": "oxlint src && eslint src",
        "lint:fix": "oxlint --fix src && eslint --fix src",
        "prebuild:expo": "pnpm --filter @rnw-community/react-native-payments-example-expo prebuild",
        "start:bare": "pnpm --filter @rnw-community/react-native-payments-example-bare start",
        "start:expo": "pnpm --filter @rnw-community/react-native-payments-example-expo start",
        "ts": "node ../../scripts/typecheck.mjs --pretty -p tsconfig.json"
    },
    "dependencies": {
        "@rnw-community/react-native-payments": "workspace:*",
        "@rnw-community/shared": "workspace:*",
        "react": "19.3.0",
        "react-native": "0.88.0"
    },
    "devDependencies": {
        "@types/react": "19.3.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
