{
    "name": "@rnw-community/react-native-collapsible-header",
    "version": "2.14.0",
    "description": "Generic Reanimated collapsible header for React Native",
    "keywords": [
        "react",
        "react-native",
        "react-native-web",
        "reanimated",
        "react-compiler",
        "collapsible header"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/rnw-community/rnw-community.git",
        "directory": "packages/react-native-collapsible-header"
    },
    "license": "MIT",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./dist/typescript/module/index.d.ts",
                "default": "./dist/module/index.js"
            },
            "require": {
                "types": "./dist/typescript/commonjs/index.d.ts",
                "default": "./dist/commonjs/index.js"
            }
        }
    },
    "main": "dist/commonjs/index.js",
    "module": "dist/module/index.js",
    "types": "dist/typescript/module/index.d.ts",
    "files": [
        "dist/**/*",
        "llms.txt"
    ],
    "scripts": {
        "build": "rm -rf ./dist && bob build && node ../../scripts/assert-esm-extensions.mjs ./dist/module && node ../../scripts/assert-react-compiler-output.mjs ./dist/module ./dist/commonjs",
        "clear": "rm -rf coverage && rm -rf dist && rm -f *.tsbuildinfo",
        "clear:deps": "rm -rf ./node_modules && rm -rf ./dist",
        "format": "prettier --write \"./src/**/*.{ts,tsx}\"",
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "ts": "tsc --pretty -p tsconfig.json",
        "ts:nodenext": "tsc --pretty -p tsconfig.nodenext-check.json"
    },
    "dependencies": {
        "@rnw-community/shared": "^2.13.0",
        "react-compiler-runtime": "^1.0.0"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@react-native/babel-preset": "0.86.2",
        "@react-native/jest-preset": "0.86.2",
        "@react-native/metro-config": "0.86.2",
        "@testing-library/react-native": "^14.0.1",
        "@types/react": "19.2.18",
        "@types/react-test-renderer": "19.1.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "react": "19.2.3",
        "react-freeze": "^1.0.3",
        "react-native": "0.86.2",
        "react-native-builder-bob": "^0.43.0",
        "react-native-reanimated": "4.5.3",
        "react-native-worklets": "0.11.3",
        "react-test-renderer": "19.2.3"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-native": ">=0.72",
        "react-native-reanimated": ">=3.17.2 <5"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "dist",
        "targets": [
            [
                "module",
                {
                    "esm": true,
                    "configFile": "./babel.config.bob.js"
                }
            ],
            [
                "commonjs",
                {
                    "esm": true,
                    "configFile": "./babel.config.bob.js"
                }
            ],
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    }
}
