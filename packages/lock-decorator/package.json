{
    "name": "@rnw-community/lock-decorator",
    "version": "2.15.0",
    "description": "Framework-agnostic sequential and exclusive method lock decorators. Dual ESM+CJS. Built on TypeScript's experimentalDecorators.",
    "keywords": [
        "decorator",
        "lock",
        "mutex",
        "sequential",
        "exclusive",
        "method decorator",
        "framework-agnostic"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/rnw-community/rnw-community.git",
        "directory": "packages/lock-decorator"
    },
    "license": "MIT",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        }
    },
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "pnpm run build:esm && pnpm run build:cjs && node ../../scripts/rewrite-esm-extensions.mjs ./dist/esm && node ../../scripts/assert-esm-extensions.mjs ./dist/esm && rm -rf ./dist/*/*.tsbuildinfo && echo '{\"type\":\"module\"}' > dist/esm/package.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
        "build:cjs": "tsc --pretty -p tsconfig.build-cjs.json",
        "build:esm": "tsc --pretty -p tsconfig.build-esm.json",
        "clear": "rm -rf coverage && rm -rf dist && rm -f *.tsbuildinfo",
        "clear:deps": "rm -rf ./node_modules && rm -rf ./dist",
        "format": "prettier --write \"./src/**/*.{ts,tsx}\"",
        "lint": "eslint src",
        "lint:fix": "eslint --fix src",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "ts": "tsc --pretty -p tsconfig.json",
        "ts:nodenext": "tsc --pretty -p tsconfig.nodenext-check.json"
    },
    "dependencies": {
        "@rnw-community/decorators-core": "workspace:^",
        "@rnw-community/shared": "workspace:^"
    },
    "devDependencies": {
        "rxjs": "^7.8.2"
    },
    "peerDependencies": {
        "rxjs": "^7.8.2",
        "typescript": ">=5.2.0"
    },
    "peerDependenciesMeta": {
        "rxjs": {
            "optional": true
        },
        "typescript": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
