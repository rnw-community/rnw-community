                "block-scoped-var": "error",
                "curly": ["error", "all"],
                "default-case-last": "error",
                "default-param-last": "error",
                "eqeqeq": ["error", "always"],
                "for-direction": "error",
                "func-name-matching": ["error", "always"],
                "func-names": ["error", "always", {}],
                "guard-for-in": "error",
                "id-denylist": "error",
